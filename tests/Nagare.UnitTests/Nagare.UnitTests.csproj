  <ItemGroup>
    <ProjectReference Include="..\..\src\Nagare.Domain\Nagare.Domain.csproj" />
    <ProjectReference Include="..\..\src\Nagare.Application\Nagare.Application.csproj" />
    <ProjectReference Include="..\..\src\Nagare.Infrastructure\Nagare.Infrastructure.csproj" />
